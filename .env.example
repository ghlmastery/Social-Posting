# Copy to .env for local runs. In GitHub Actions, set these as repository/environment secrets instead
# (see docs/SETUP.md) — do not commit a real .env file.

# --- Anthropic (Claude) — used for captions, daily ideas, script rewrites ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- GoHighLevel Social Planner (Social Media Posting API) ---
# Private Integration Token (or sub-account OAuth token) with
# socialplanner/account.readonly, socialplanner/account.write,
# socialplanner/post.readonly, socialplanner/post.write scopes.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# Social Planner account IDs (from GET /social-media-posting/{locationId}/accounts),
# run `npm run verify:connections` after setting GHL_API_TOKEN/GHL_LOCATION_ID to list these.
GHL_FACEBOOK_ACCOUNT_ID=
GHL_INSTAGRAM_ACCOUNT_ID=
GHL_YOUTUBE_ACCOUNT_ID=

# --- Google (Drive + Docs + optionally YouTube Data API auth) ---
# Base64-encoded contents of a Google service-account JSON key. The service
# account's email must be shared (Viewer) on the Drive folder and the Doc below.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Folder the system watches for newly-uploaded, ready-to-post videos.
GOOGLE_DRIVE_INBOX_FOLDER_ID=
# Optional: videos are moved here (or tagged) once scheduled, so they aren't reposted.
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=
# Optional: where generated content-idea and competitor-script docs get written.
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=

# Google Doc ID of your content framework
# (https://docs.google.com/document/d/1asmHwaH9GraMqpYWlR5BdNngAty13OU5koiZktMj8kM/edit -> the ID is the segment after /d/)
CONTENT_FRAMEWORK_DOC_ID=1asmHwaH9GraMqpYWlR5BdNngAty13OU5koiZktMj8kM

# --- YouTube Data API (public search — simple API key, no OAuth needed) ---
YOUTUBE_API_KEY=
# Comma-separated search terms used to find competitor content. Keep these
# specific to the niche — generic terms like "business coaching" alone match
# any coach in any language/market, not just agency/GHL-space competitors.
COMPETITOR_NICHE_KEYWORDS=GoHighLevel,GoHighLevel agency,GHL SaaS,SaaS agency owner,white label SaaS agency,scale your marketing agency,agency owner coaching,consulting business for agencies
# Optional: comma-separated known competitor channel IDs/handles to prioritize.
COMPETITOR_YOUTUBE_CHANNELS=
# Restricts search results to this language/region so broad keywords don't
# pull in unrelated-market content. Change if you're targeting a different
# audience.
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_REGION_CODE=US

# --- Fathom (call insights — coaching/sales call themes feed into daily ideas) ---
# Generate from Fathom Settings -> API Access (available on all plans).
FATHOM_API_KEY=
FATHOM_API_BASE_URL=https://api.fathom.ai/external/v1
# Comma-separated company email domains (e.g. rmmarketing.ca,ghlmastery.com).
# A meeting where every attendee is on one of these domains is treated as an
# internal meeting and excluded from theme extraction. This is a stand-in for
# properly separating coaching/client calls from internal ones in Fathom by
# team/tag — leave empty and everything synced is treated as a client call.
FATHOM_INTERNAL_EMAIL_DOMAINS=
# How many days back to look on the very first sync (later syncs pick up from
# the last sync timestamp automatically).
FATHOM_LOOKBACK_DAYS=7
# Off by default: call summaries + action items are enough signal for theme
# extraction, and skipping raw transcripts keeps less verbatim client detail
# in play. Set to true only if summaries prove too thin.
FATHOM_INCLUDE_TRANSCRIPT=false

# --- Behavior ---
# Timezone used for scheduling display/calculations.
POSTING_TIMEZONE=America/Toronto
# Comma-separated local times (24h HH:mm) new videos get queued into, round-robin.
POSTING_SLOT_TIMES=09:00,13:00,17:00
# Where run state (processed files, idea/competitor history) is persisted.
STATE_FILE_PATH=./data/state.json
# When true, no GHL posts are actually created/scheduled — everything is logged instead.
# Keep this true until you've run verify:connections and checked a dry-run ingest job.
DRY_RUN=true
